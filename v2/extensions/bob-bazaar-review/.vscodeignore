# Source and build configuration not needed at runtime
src/**
docs/**
*.ts
out/**/*.map
*.tsbuildinfo
tsconfig.json

# Dependency caches and package-manager files
node_modules/**
!node_modules/js-yaml/**
!node_modules/argparse/**
npm-debug.log*
yarn.lock
package-lock.json
pnpm-lock.yaml

# Local editor/runtime files
.vscode/**
.vscode-test.json
*.vsix
.DS_Store
Thumbs.db

# Tests and temporary output
test/**
tests/**
coverage/**
.tmp/**
tmp/**

# Repository metadata
.git/**
.gitignore
