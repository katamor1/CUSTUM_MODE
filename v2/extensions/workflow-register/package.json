{
  "name": "workflow-register",
  "displayName": "Bob ワークフロー登録",
  "description": ".bob/workflows/*/WORKFLOW.md に定義された IBM Bob ワークフローを登録します。",
  "version": "0.1.0",
  "publisher": "local",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "directory": "extensions/workflow-register"
  },
  "engines": {
    "vscode": "^1.106.1"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:workflowRegister.runs",
    "onCommand:workflowRegister.reload",
    "onCommand:workflowRegister.inspect",
    "onCommand:workflowRegister.completeCurrentStep",
    "onCommand:workflowRegister.completeStep",
    "onCommand:workflowRegister.inspectActiveSteps",
    "onCommand:workflowRegister.runWorkflow",
    "onCommand:workflowRegister.runWorkflowStep",
    "onCommand:workflowRegister.inspectRuns",
    "onCommand:workflowRegister.resumeRun",
    "onCommand:workflowRegister.retryCurrentStep",
    "onCommand:workflowRegister.acceptCurrentStep",
    "onCommand:workflowRegister.runNextStep",
    "onCommand:workflowRegister.openManualStepPanel",
    "onCommand:workflowRegister.acceptAndRunNextStep",
    "onCommand:workflowRegister.inspectCurrentStep",
    "onCommand:workflowRegister.pauseCurrentRun",
    "onCommand:workflowRegister.pauseAfterCurrentStep",
    "onCommand:workflowRegister.pauseBeforeNextAiCall",
    "onCommand:workflowRegister.resumePausedRun",
    "onCommand:workflowRegister.inspectRunControl",
    "onCommand:workflowRegister.approveBranchCheckpoint",
    "onCommand:workflowRegister.abortBranchCheckpoint",
    "onCommand:workflowRegister.inspectBranching",
    "onCommand:workflowRegister.refreshRunsView",
    "onCommand:workflowRegister.openCurrentStepInBuilder",
    "onCommand:workflowRegister.inspectRunDiagnostics",
    "onCommand:workflowRegister.designWorkflowWithAi",
    "onCommand:workflowRegister.improveWorkflowWithAi",
    "onCommand:workflowRegister.explainWorkflowDiagnostics",
    "onCommand:workflowRegister.validateCurrentWorkflow",
    "onCommand:workflowRegister.validateWorkspaceWorkflows",
    "onCommand:workflowRegister.createWorkflowFromTemplate",
    "onCommand:workflowRegister.openWorkflowBuilder",
    "onCommand:workflowRegister.editWorkflowInBuilder"
  ],
  "main": "./out/extensionWithAuthoring.js",
  "contributes": {
    "commands": [
      { "command": "workflowRegister.reload", "title": "Bob ワークフロー: ファイルを再読み込み", "category": "Bob ワークフロー" },
      { "command": "workflowRegister.inspect", "title": "Bob ワークフロー: 登録状態を確認", "category": "Bob ワークフロー" },
      { "command": "workflowRegister.completeCurrentStep", "title": "Bob ワークフロー: 現在のステップを完了", "category": "Bob ワークフロー" },
      { "command": "workflowRegister.completeStep", "title": "現在のワークフローステップを完了", "category": "ワークフローステップ" },
      { "command": "workflowRegister.inspectActiveSteps", "title": "Bob ワークフロー: 実行中ステップを確認", "category": "Bob ワークフロー" },
      { "command": "workflowRegister.runWorkflow", "title": "Bob ワークフロー: 実行", "category": "Bob ワークフロー" },
      { "command": "workflowRegister.runWorkflowStep", "title": "Bob ワークフロー: ステップを実行", "category": "Bob ワークフロー" },
      { "command": "workflowRegister.inspectRuns", "title": "Bob ワークフロー: 実行履歴を確認", "category": "Bob ワークフロー" },
      { "command": "workflowRegister.resumeRun", "title": "Bob ワークフロー: 実行を再開", "category": "Bob ワークフロー" },
      { "command": "workflowRegister.retryCurrentStep", "title": "Bob ワークフロー: 現在のステップを再試行", "category": "Bob ワークフロー" },
      { "command": "workflowRegister.acceptCurrentStep", "title": "Bob ワークフロー: 現在のステップ結果を承認", "category": "Bob ワークフロー" },
      { "command": "workflowRegister.runNextStep", "title": "Bob ワークフロー: 次のステップを実行", "category": "Bob ワークフロー" },
      { "command": "workflowRegister.openManualStepPanel", "title": "Bob ワークフロー: 手動操作ステップを開く", "category": "Bob ワークフロー" },
      { "command": "workflowRegister.acceptAndRunNextStep", "title": "Bob ワークフロー: 承認して次のステップを実行", "category": "Bob ワークフロー" },
      { "command": "workflowRegister.inspectCurrentStep", "title": "Bob ワークフロー: 現在のステップ状態を確認", "category": "Bob ワークフロー" },
      { "command": "workflowRegister.pauseCurrentRun", "title": "Bob ワークフロー: 実行中 run を中断", "category": "Bob ワークフロー" },
      { "command": "workflowRegister.pauseAfterCurrentStep", "title": "Bob ワークフロー: 現在ステップ後に中断", "category": "Bob ワークフロー" },
      { "command": "workflowRegister.pauseBeforeNextAiCall", "title": "Bob ワークフロー: 次のAI呼び出し前に中断", "category": "Bob ワークフロー" },
      { "command": "workflowRegister.resumePausedRun", "title": "Bob ワークフロー: 中断 run を再開", "category": "Bob ワークフロー" },
      { "command": "workflowRegister.inspectRunControl", "title": "Bob ワークフロー: 中断・再開状態を確認", "category": "Bob ワークフロー" },
      { "command": "workflowRegister.approveBranchCheckpoint", "title": "Bob ワークフロー: ループ上限を承認して続行", "category": "Bob ワークフロー" },
      { "command": "workflowRegister.abortBranchCheckpoint", "title": "Bob ワークフロー: ループ上限で中止", "category": "Bob ワークフロー" },
      { "command": "workflowRegister.inspectBranching", "title": "Bob ワークフロー: 分岐状態を確認", "category": "Bob ワークフロー" },
      { "command": "workflowRegister.refreshRunsView", "title": "Bob ワークフロー: 実行一覧を更新", "category": "Bob ワークフロー" },
      { "command": "workflowRegister.openCurrentStepInBuilder", "title": "Bob ワークフロー: 現在のステップをGUIで編集", "category": "Bob ワークフロー" },
      { "command": "workflowRegister.inspectRunDiagnostics", "title": "Bob ワークフロー: 診断を確認", "category": "Bob ワークフロー" },
      { "command": "workflowRegister.designWorkflowWithAi", "title": "Bob ワークフロー: AI で新規設計", "category": "Bob ワークフロー" },
      { "command": "workflowRegister.improveWorkflowWithAi", "title": "Bob ワークフロー: AI で改善", "category": "Bob ワークフロー" },
      { "command": "workflowRegister.explainWorkflowDiagnostics", "title": "Bob ワークフロー: 診断を AI で説明", "category": "Bob ワークフロー" },
      { "command": "workflowRegister.validateCurrentWorkflow", "title": "Bob ワークフロー: 現在の定義を検証", "category": "Bob ワークフロー" },
      { "command": "workflowRegister.validateWorkspaceWorkflows", "title": "Bob ワークフロー: ワークスペース定義を検証", "category": "Bob ワークフロー" },
      { "command": "workflowRegister.createWorkflowFromTemplate", "title": "Bob ワークフロー: テンプレートから作成", "category": "Bob ワークフロー" },
      { "command": "workflowRegister.openWorkflowBuilder", "title": "Bob ワークフロー: GUI で作成", "category": "Bob ワークフロー" },
      { "command": "workflowRegister.editWorkflowInBuilder", "title": "Bob ワークフロー: GUI で編集", "category": "Bob ワークフロー" }
    ],
    "views": {
      "explorer": [
        {
          "id": "workflowRegister.runs",
          "name": "Bob Workflow Runs"
        }
      ]
    },
    "configuration": {
      "title": "Bob ワークフロー登録",
      "properties": {
        "workflowRegister.sourceId": {
          "type": "string",
          "default": "workflow-register",
          "description": "IBM Bob へワークフローを登録するときに使う source id。"
        },
        "workflowRegister.sourceName": {
          "type": "string",
          "default": "ワークフロー登録",
          "description": "IBM Bob に表示される source name。"
        },
        "workflowRegister.agentCommand": {
          "type": "string",
          "default": "",
          "description": "standalone workflow engine が agent step を実行するときに使う任意の VS Code command。AgentExecutionInput object を受け取り、text / result / output / content を含む text または object を返す必要があります。"
        },
        "workflowRegister.aiProviderCommand": {
          "type": "string",
          "default": "",
          "description": "WorkflowAiProvider として使う任意の VS Code command。{ kind, payload } を受け取り、workflow design draft、repair proposal、diagnostic explanation を返します。"
        },
        "workflowRegister.taskSnapshots.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Bob UI 実行時に .bob/workflows/runs/<runId>/task-snapshots へ補助 snapshot を保存します。"
        },
        "workflowRegister.taskSnapshots.maxBytes": {
          "type": "number",
          "default": 262144,
          "minimum": 1024,
          "description": "1 task snapshot JSON の最大サイズ。超過時は古い messages から省略します。"
        },
        "workflowRegister.taskSnapshots.maxPerRun": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "description": "1 run に保持する snapshot 数。latest.json はこの数に含めません。"
        },
        "workflowRegister.taskSnapshots.includeMessages": {
          "type": "boolean",
          "default": false,
          "description": "task snapshot に Bob chat messages を含めます。必要な場合のみ明示的に有効化してください。無効時も metadata と lastAssistantText は redaction 後に保存対象です。"
        },
        "workflowRegister.taskSnapshots.pruneOnSave": {
          "type": "boolean",
          "default": true,
          "description": "snapshot 保存時に maxPerRun を超えた古い snapshot を削除します。"
        }
      }
    },
    "menus": {
      "commandPalette": [
        { "command": "workflowRegister.reload" },
        { "command": "workflowRegister.inspect" },
        { "command": "workflowRegister.completeCurrentStep" },
        { "command": "workflowRegister.completeStep" },
        { "command": "workflowRegister.inspectActiveSteps" },
        { "command": "workflowRegister.runWorkflow" },
        { "command": "workflowRegister.runWorkflowStep" },
        { "command": "workflowRegister.inspectRuns" },
        { "command": "workflowRegister.resumeRun" },
        { "command": "workflowRegister.retryCurrentStep" },
        { "command": "workflowRegister.acceptCurrentStep" },
        { "command": "workflowRegister.runNextStep" },
        { "command": "workflowRegister.openManualStepPanel" },
        { "command": "workflowRegister.acceptAndRunNextStep" },
        { "command": "workflowRegister.inspectCurrentStep" },
        { "command": "workflowRegister.pauseCurrentRun" },
        { "command": "workflowRegister.pauseAfterCurrentStep" },
        { "command": "workflowRegister.pauseBeforeNextAiCall" },
        { "command": "workflowRegister.resumePausedRun" },
        { "command": "workflowRegister.inspectRunControl" },
        { "command": "workflowRegister.approveBranchCheckpoint" },
        { "command": "workflowRegister.abortBranchCheckpoint" },
        { "command": "workflowRegister.inspectBranching" },
        { "command": "workflowRegister.refreshRunsView" },
        { "command": "workflowRegister.openCurrentStepInBuilder" },
        { "command": "workflowRegister.inspectRunDiagnostics" },
        { "command": "workflowRegister.designWorkflowWithAi" },
        { "command": "workflowRegister.improveWorkflowWithAi" },
        { "command": "workflowRegister.explainWorkflowDiagnostics" },
        { "command": "workflowRegister.validateCurrentWorkflow" },
        { "command": "workflowRegister.validateWorkspaceWorkflows" },
        { "command": "workflowRegister.createWorkflowFromTemplate" },
        { "command": "workflowRegister.openWorkflowBuilder" },
        { "command": "workflowRegister.editWorkflowInBuilder" }
      ],
      "view/title": [
        {
          "command": "workflowRegister.refreshRunsView",
          "when": "view == workflowRegister.runs",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "workflowRegister.inspectRunControl",
          "when": "view == workflowRegister.runs",
          "group": "inline"
        },
        {
          "command": "workflowRegister.pauseAfterCurrentStep",
          "when": "view == workflowRegister.runs && viewItem =~ /workflowRun\\.(running|reviewing|held)/",
          "group": "inline"
        },
        {
          "command": "workflowRegister.openManualStepPanel",
          "when": "view == workflowRegister.runs && viewItem == workflowRun.held",
          "group": "inline"
        },
        {
          "command": "workflowRegister.resumePausedRun",
          "when": "view == workflowRegister.runs && viewItem == workflowRun.paused",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "architecture:policy": "node ../../scripts/check-import-cycles.js src",
    "source:policy": "node ../../scripts/check-export-star-policy.js src --allow src/core/model.ts",
    "schema:policy": "npm run compile && node --test test/workflowAuthoring.test.js",
    "unused:report": "node ../../scripts/run-unused-checks.js",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "compile": "tsc -p ./",
    "dependency:policy": "node --test test/dependencyPolicy.test.js",
    "test": "npm run compile && node --test test/*.test.js",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "package:policy": "node ../../scripts/check-vsix-policy.js --max-bytes 1200000"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.106.0",
    "depcheck": "^1.4.7",
    "knip": "^5.0.0",
    "ts-prune": "^0.10.3",
    "typescript": "^5.4.5",
    "@vscode/vsce": "^3.2.1"
  }
}
